# AutoClaim AI — environment template (never commit real secrets)
APP_NAME=AutoClaim AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-64-char-random-string-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://autoclaim:autoclaim_secret@postgres:5432/autoclaim
DATABASE_URL_SYNC=postgresql://autoclaim:autoclaim_secret@postgres:5432/autoclaim
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ORIGINS=http://localhost:5173,http://localhost:80
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FILE_STORAGE_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
AES_MASTER_KEY=change-me-32-byte-base64-key-here!!
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@autoclaim.ai
SMS_PROVIDER=console
SENTRY_DSN=
ENABLE_VIRUS_SCAN=false
MFA_ISSUER=AutoClaimAI
